# PostgreSQL connection for the normalized osu_eval schema.
DATABASE_URL=postgresql://osu_app:change_me@localhost:5432/osu_data

# Optional on-demand translation ai services. Server-only: never prefix these with NEXT_PUBLIC_.
# Accepts a base URL or the full /api/generate URL. Blank skips ai services and uses Google.
KJCH_AI_SERVICES_API_URL=https://ai-services.example.com
KJCH_AI_SERVICES_CF_CLIENT_ID=
KJCH_AI_SERVICES_CF_CLIENT_SECRET=
# Must match the model name registered in Ollama (e.g. test-model:latest).
KJCH_AI_SERVICES_MODEL=test-model:latest
# These four policy values seed the database once. Later use translation:manage configure.
KJCH_AI_SERVICES_TIMEOUT_MS=6000
KJCH_AI_SERVICES_SLOW_MS=2500
KJCH_AI_SERVICES_MAX_CONCURRENCY=1
KJCH_AI_SERVICES_COOLDOWN_MS=30000
# Install provider state and statistics with pnpm db:translation:init.
# This flag disables summary counters only; provider state and audits remain active.
TRANSLATION_USAGE_ENABLED=true

# Optional public origin for absolute Open Graph / Twitter image URLs.
# Set to the deployed site's URL in production. Blank uses Vercel's origin,
# when available, or http://localhost:3000 for local development.
SITE_URL=

# Server-only maintenance key. Production tools stay locked when blank.
# Never prefix with NEXT_PUBLIC_. Choose a long, unique value in .env.local / hosting secrets.
DEV_DEBUG_KEY=

# Optional Umami analytics. Configure these public values before building the app.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
NEXT_PUBLIC_UMAMI_TRACKER_URL=https://example.com/umami_main.js
NEXT_PUBLIC_UMAMI_RECORDER_URL=https://example.com/recorder.js

# Required only when running the collector. Do not persist the opaque Blue URL in metadata.
OSU_BLUE_PUBLIC_URL=https://osu.bluera.com/osubpi/fbview.aspx?blockid=REPLACE_ME&userid=REPLACE_ME&lng=en
