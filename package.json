{
  "name": "osu-eval",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && pnpm lint:css",
    "lint:css": "node scripts/styles/check-css.mjs",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "brand:icons": "node scripts/brand/generate-icons.mjs",
    "brand:social": "node scripts/brand/generate-social.mjs",
    "db:validate": "python3 scripts/evaluations/import_osu_sei_ssle_postgres.py --file data/raw/blue-sei-ssle-su22-su26/osu_sei_ssle_all.jsonl --validate-only --expected-rows 68729",
    "db:import": "python3 scripts/evaluations/import_osu_sei_ssle_postgres.py --file data/raw/blue-sei-ssle-su22-su26/osu_sei_ssle_all.jsonl --dsn \"$DATABASE_URL\" --init-schema --expected-rows 68729",
    "db:people:init": "node --env-file-if-exists=.env.local scripts/people/setup_people_directory.mjs",
    "db:translation:init": "node --env-file-if-exists=.env.local scripts/translation/setup_usage.mjs",
    "translation:status": "node --env-file-if-exists=.env.local scripts/translation/manage.mjs status",
    "translation:manage": "node --env-file-if-exists=.env.local scripts/translation/manage.mjs",
    "rmp:collect": "python3 scripts/rmp/collect_rmp_osu.py",
    "rmp:mappings": "python3 scripts/rmp/sync_rmp_mappings.py",
    "rmp:supplement": "python3 scripts/rmp/import_rmp_supplement.py",
    "typecheck": "next typegen && tsc --noEmit",
    "catalog:sync": "node scripts/catalog/sync_osu_catalog.mjs",
    "catalog:discover": "node scripts/catalog/sync_osu_catalog.mjs --discover-only",
    "test": "node --test tests/**/*.test.mjs",
    "test:python": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "catalog:migrate": "node scripts/catalog/migrate_catalog.mjs",
    "catalog:prune": "node scripts/catalog/prune_snapshots.mjs"
  },
  "dependencies": {
    "@iconify/react": "^5.2.1",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^16.1.0",
    "pg": "^8.16.3",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.0",
    "vaul": "^1.1.2",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.35.0",
    "eslint-config-next": "^16.1.0",
    "postcss": "8.5.32",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
