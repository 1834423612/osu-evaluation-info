{
  "name": "osu-eval",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "db:validate": "python3 scripts/import_osu_sei_ssle_postgres.py --file data/raw/blue-sei-ssle-su22-su26/osu_sei_ssle_all.jsonl --validate-only --expected-rows 68729",
    "db:import": "python3 scripts/import_osu_sei_ssle_postgres.py --file data/raw/blue-sei-ssle-su22-su26/osu_sei_ssle_all.jsonl --dsn \"$DATABASE_URL\" --init-schema --expected-rows 68729",
    "rmp:collect": "python3 scripts/collect_rmp_osu.py",
    "rmp:mappings": "python3 scripts/sync_rmp_mappings.py",
    "rmp:supplement": "python3 scripts/import_rmp_supplement.py",
    "typecheck": "next typegen && tsc --noEmit",
    "catalog:sync": "node scripts/sync_osu_catalog.mjs",
    "catalog:discover": "node scripts/sync_osu_catalog.mjs --discover-only",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@iconify/react": "^5.2.1",
    "@radix-ui/react-dialog": "^1.1.14",
